# Choose: gemini, nvidia, or openai
AI_PROVIDER=gemini

# Text-to-SQL provider (required for natural-language SQL queries)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional text-to-SQL provider alternatives
# NVIDIA_API_KEY=your_nvidia_api_key_here
# NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Optional multimodal providers
# VISION_API_KEY=your_vision_api_key_here
# VISION_MODEL=gpt-4o-mini
# VISION_BASE_URL=
# TRANSCRIPTION_API_KEY=your_transcription_api_key_here
# TRANSCRIPTION_MODEL=whisper-1
# TRANSCRIPTION_BASE_URL=

# Optional media configuration
# MEDIA_STORAGE_DIR=./media_store
# MAX_UPLOAD_BYTES=52428800
